local function getTFolder() 
    return CharactersFolder and CharactersFolder:FindFirstChild("Terrorists") or nil
end

local function getCTFolder() 
    return CharactersFolder and CharactersFolder:FindFirstChild("Counter-Terrorists") or nil
end

local function isAlive()
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    
    local t, ct = getTFolder(), getCTFolder()
    return (t and t:FindFirstChild(player.Name)) or (ct and ct:FindFirstChild(player.Name))
end

local function getEnemyFolder()
    if not isAlive() then return nil end
    local t, ct = getTFolder(), getCTFolder()
    if not t or not ct then return nil end
    
    if t:FindFirstChild(player.Name) then 
        return ct 
    elseif ct:FindFirstChild(player.Name) then 
        return t 
    end
    return nil
end

