--// ==========================================
local EspC4Enabled = false
local c4EspCache = {}
local activeC4s = {}

local function createC4ESP()
    local esp = {
        boxOutline = Drawing.new("Square"),
        box = Drawing.new("Square"),
        text = Drawing.new("Text")
    }
    esp.boxOutline.Thickness = 3; esp.boxOutline.Filled = false; esp.boxOutline.Color = Color3.new(0, 0, 0)
    esp.box.Thickness = 1; esp.box.Filled = false; esp.box.Color = Color3.new(1, 1, 1)
    esp.text.Center = true; esp.text.Outline = true; esp.text.Color = Color3.new(1, 1, 1); esp.text.Size = 14; esp.text.Text = "C4"
    return esp
end

local function getCFrameAndSize(obj)
    if obj:IsA("Model") then return obj:GetBoundingBox()
    elseif obj:IsA("BasePart") then return obj.CFrame, obj.Size end
    return nil, nil
end

local function checkAndAddC4(obj)
    if obj and obj.Name then
        local n = string.lower(obj.Name)
        if (n == "c4" or n == "plantedc4" or string.find(n, "c4")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
            activeC4s[obj] = true
        end
    end
end

-- Busca inicial rápida
task.spawn(function()
    for _, obj in ipairs(Workspace:GetDescendants()) do checkAndAddC4(obj) end
end)

-- Eventos de rastreamento inteligentes (zero lag loop)
Workspace.DescendantAdded:Connect(checkAndAddC4)
Workspace.DescendantRemoving:Connect(function(obj)
    if activeC4s[obj] then activeC4s[obj] = nil end
end)

local function isValidC4State(obj)
    if not obj or not obj.Parent then return false end
    
    local charModel = obj:FindFirstAncestorOfClass("Model")
    if charModel and charModel:FindFirstChildOfClass("Humanoid") then
        return true -- Está na mão de alguém
    end
    
    if obj:IsDescendantOf(Workspace) and not obj:IsDescendantOf(camera) then
        return true -- Está dropada/plantada no chão
    end
    
    return false
end

RunService.RenderStepped:Connect(function()
    if not EspC4Enabled then
        for _, esp in pairs(c4EspCache) do
            esp.boxOutline.Visible = false; esp.box.Visible = false; esp.text.Visible = false
        end
        return
    end

    for c4Obj, _ in pairs(activeC4s) do
        if isValidC4State(c4Obj) then
            if not c4EspCache[c4Obj] then c4EspCache[c4Obj] = createC4ESP() end
            local esp = c4EspCache[c4Obj]
            
            pcall(function()
                local cf, size = getCFrameAndSize(c4Obj)
                if cf and size then
                    local pos, onScreen = camera:WorldToViewportPoint(cf.Position)
                    local topPos = camera:WorldToViewportPoint((cf * CFrame.new(0, size.Y / 2, 0)).Position)
                    local botPos = camera:WorldToViewportPoint((cf * CFrame.new(0, -size.Y / 2, 0)).Position)
                    
                    if onScreen then
                        local boxH = math.abs(topPos.Y - botPos.Y)
                        local boxW = math.max(boxH, 20)
                        
                        esp.boxOutline.Size = Vector2.new(boxW, boxH); esp.boxOutline.Position = Vector2.new(pos.X - boxW / 2, topPos.Y); esp.boxOutline.Visible = true
                        esp.box.Size = Vector2.new(boxW, boxH); esp.box.Position = Vector2.new(pos.X - boxW / 2, topPos.Y); esp.box.Visible = true
                        esp.text.Position = Vector2.new(pos.X, topPos.Y - 18); esp.text.Visible = true
                    else
                        esp.boxOutline.Visible = false; esp.box.Visible = false; esp.text.Visible = false
                    end
                else
                    esp.boxOutline.Visible = false; esp.box.Visible = false; esp.text.Visible = false
                end
            end)
        else
            if c4EspCache[c4Obj] then
                c4EspCache[c4Obj].boxOutline.Visible = false
                c4EspCache[c4Obj].box.Visible = false
                c4EspCache[c4Obj].text.Visible = false
            end
        end
    end
    
    for c4Obj, esp in pairs(c4EspCache) do
        if not activeC4s[c4Obj] or not c4Obj.Parent then
            pcall(function() esp.boxOutline:Remove(); esp.box:Remove(); esp.text:Remove() end)
            c4EspCache[c4Obj] = nil
        end
    end
end)

