--// RENDER STEPPED (FAST VISUALS LOOP) - OPTIMIZED
RunService.RenderStepped:Connect(function()
    local living = isAlive()
    local enemyFolder = living and getEnemyFolder() or nil

    -- FOV circle
    if ShowFOV then
        FOVCircle.Position = UserInputService:GetMouseLocation()
        FOVCircle.Radius = FOV_Radius
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    -- Aimbot
    if AimbotToggled and living and LockedTarget then
        local targetHead = LockedTarget:FindFirstChild("Head")
        if targetHead then
            local currentCamCFrame = camera.CFrame
            local targetCFrame = CFrame_new(currentCamCFrame.Position, targetHead.Position)
            local alpha = math_clamp(1 / math_max(Smoothing, 1), 0.1, 1)
            camera.CFrame = currentCamCFrame:Lerp(targetCFrame, alpha)
        end
    end

    -- Custom knife viewmodel
    if scriptRunning then
        forceHideOriginalKnife()
        if not spawned and living then
            for _, c in ipairs(camera:GetChildren()) do
                local n = string.lower(c.Name)
                if c ~= vm and (string.find(n, "knife") or string.find(n, "melee") or string.find(n, "karambit")) and not c:GetAttribute("IsCustomKnife") then
                    spawnViewmodel()
                    break
                end
            end
        end
        if spawned and vm and vm.PrimaryPart then
            vm.PrimaryPart.CFrame = camera.CFrame * knives[selectedKnife].Offset
            if not (equipAnim and equipAnim.IsPlaying) and not inspecting and not swinging then
                if idleAnim and not idleAnim.IsPlaying then idleAnim:Play() end
            end
        end
    end

    -- Cleaner ESP: outline only, no fill (more optimized, less clutter)
    if EspDamageEnabled and living and enemyFolder then
        local tFolder = getTFolder()
        local ctFolder = getCTFolder()

        for _, enemy in ipairs(enemyFolder:GetChildren()) do
            local hum = enemy:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local h = chamsCache[enemy]
                if not h then
                    h = Instance.new("Highlight")
                    h.Name = "DmgHighlight"
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.FillTransparency = 1        -- No fill
                    h.OutlineTransparency = 0
                    h.Parent = enemy
                    chamsCache[enemy] = h
                end

                local teamColor = Color3_fromRGB(255, 255, 255)
                if tFolder and enemy:IsDescendantOf(tFolder) then
                    teamColor = Color3_fromRGB(255, 170, 0)   -- T
                elseif ctFolder and enemy:IsDescendantOf(ctFolder) then
                    teamColor = Color3_fromRGB(0, 170, 255)    -- CT
                end

                h.Adornee = enemy
                h.OutlineColor = teamColor
                h.Enabled = true
            else
                if chamsCache[enemy] then chamsCache[enemy].Enabled = false end
            end
        end
    else
        for _, h in pairs(chamsCache) do
            if h and h.Parent then h.Enabled = false end
        end
    end

    -- ESP Names + HP (clean, no outline)
    if EspNamesEnabled and living and enemyFolder then
        for _, enemy in ipairs(enemyFolder:GetChildren()) do
            local hum = enemy:FindFirstChildOfClass("Humanoid")
            local head = enemy:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local headPos, onScreen = camera:WorldToViewportPoint(head.Position + Vector3_new(0, 1.5, 0))

                if not espTexts[enemy] then
                    local textObj = Drawing.new("Text")
                    textObj.Size = 14
                    textObj.Center = true
                    textObj.Outline = false
                    textObj.Color = Color3_fromRGB(255, 255, 255)
                    espTexts[enemy] = { NameHP = textObj }
                end

                local texts = espTexts[enemy]
                if onScreen then
                    texts.NameHP.Text = string.format("%s [%d HP]", enemy.Name, math_floor(hum.Health))
                    texts.NameHP.Position = Vector2_new(headPos.X, headPos.Y - 25)
                    texts.NameHP.Visible = true
                else
                    texts.NameHP.Visible = false
                end
            else
                if espTexts[enemy] then
                    espTexts[enemy].NameHP.Visible = false
                end
            end
        end
    else
        for _, texts in pairs(espTexts) do
            texts.NameHP.Visible = false
        end
    end
end)

--// HEARTBEAT (PHYSICS & REGULATED UPDATES) - OPTIMIZED
local lastSlowUpdate = 0
local espCacheTimer = 0

RunService.Heartbeat:Connect(function(dt)
    local now = os_clock()
    local living = isAlive()

    -- Aimbot lock acquisition
    if AimbotToggled and living and AimbotMasterEnabled then
        if not LockedTarget or not LockedTarget.Parent or not LockedTarget:FindFirstChild("Humanoid") or LockedTarget.Humanoid.Health <= 0 then
            LockedTarget = getClosestEnemyToMouse()
        end
    else
        LockedTarget = nil
    end

    -- Bunny hop
    if BhopEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) and living and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum:GetState() ~= Enum.HumanoidStateType.Jumping and hum:GetState() ~= Enum.HumanoidStateType.Freefall then
            hum.Jump = true
        end
    end

    -- TriggerBot (auto-fire when crosshair on enemy)
    if TriggerBotEnabled and living then
        local ignoreList = {camera}
        if player.Character then table.insert(ignoreList, player.Character) end
        triggerRayParams.FilterDescendantsInstances = ignoreList

        local vp = camera.ViewportSize
        local ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
        local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, triggerRayParams)

        if result and result.Instance then
            local model = result.Instance:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChildOfClass("Humanoid") then
                local enemyFolder = getEnemyFolder()
                if enemyFolder and model.Parent == enemyFolder then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        if now - lastTriggerShot > (TriggerBotDelay / 1000) + 0.05 then
                            lastTriggerShot = now
                            if TriggerBotDelay > 0 then
                                task.delay(TriggerBotDelay / 1000, function()
                                    if mouse1click then mouse1click() end
                                end)
                            else
                                if mouse1click then mouse1click() end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Clean up stale ESP & chams caches (every 0.3s)
    espCacheTimer = espCacheTimer + dt
    if espCacheTimer >= 0.3 then
        espCacheTimer = 0
        local enemyFolder = getEnemyFolder()

        -- Collect espTexts to remove
        local toRemoveEsp = {}
        for enemy, texts in pairs(espTexts) do
            local isValid = false
            if enemy and enemy.Parent and enemyFolder and enemy.Parent == enemyFolder then
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then isValid = true end
            end
            if not isValid or not EspNamesEnabled or not living then
                table.insert(toRemoveEsp, enemy)
            end
        end
        for _, enemy in ipairs(toRemoveEsp) do
            local texts = espTexts[enemy]
            if texts then
                pcall(function() texts.NameHP:Remove() end)
                espTexts[enemy] = nil
            end
        end

        -- Collect chams to remove
        local toRemoveChams = {}
        for enemy, h in pairs(chamsCache) do
            if not enemy or not enemy.Parent or not enemy:FindFirstChildOfClass("Humanoid") or enemy.Humanoid.Health <= 0 then
                table.insert(toRemoveChams, enemy)
            end
        end
        for _, enemy in ipairs(toRemoveChams) do
            local h = chamsCache[enemy]
            if h then
                pcall(function() h:Destroy() end)
                chamsCache[enemy] = nil
            end
        end
    end

    -- Slow tasks (0.5s interval)
    if now - lastSlowUpdate >= 0.5 then
        lastSlowUpdate = now

        -- Hitbox expander
        if HitboxEnabled then
            local enemyFolder = getEnemyFolder()
            if enemyFolder then
                for _, enemy in ipairs(enemyFolder:GetChildren()) do
                    if enemy and enemy.Parent then
                        local hum = enemy:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local head = enemy:FindFirstChild("Head")
                            if head then
                                -- Store original size if not already
                                if not originalHeadSizes[head] then
                                    originalHeadSizes[head] = head.Size
                                end

                                if HitboxSize > 0 then
                                    head.Size = Vector3_new(HitboxSize, HitboxSize, HitboxSize)
                                    head.Massless = true
                                    head.CanCollide = false
                                    head.Transparency = 0.5
                                else
                                    head.Size = originalHeadSizes[head]
                                    head.Massless = false
                                    head.Transparency = 0
                                end
                            end
                        end
                    end
                end
            end
        end

        -- Anti-Flash
        if AntiFlashEnabled then
            pcall(function()
                local gui = player.PlayerGui:FindFirstChild("FlashbangEffect")
                local effect = Lighting:FindFirstChild("FlashbangColorCorrection")
                if gui then gui:Destroy() end
                if effect then effect:Destroy() end
            end)
        end

        -- Anti-Smoke
        if AntiSmokeEnabled then
            pcall(function()
                local debris = Workspace:FindFirstChild("Debris")
                if debris then
                    for _, folder in ipairs(debris:GetChildren()) do
                        if folder and string.match(folder.Name, "Voxel") then
                            folder:ClearAllChildren()
                            folder:Destroy()
                        end
                    end
                end
            end)
        end
    end
end)

